{
  "name": "sidebet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:concurrency": "vitest run tests/concurrency",
    "e2e": "node scripts/e2e-two-sessions.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:live": "node scripts/live-source-check.mjs",
    "db:migrate": "tsx --conditions=react-server scripts/db.ts migrate",
    "db:seed": "tsx --conditions=react-server scripts/db.ts seed",
    "make-admin": "tsx --conditions=react-server scripts/db.ts make-admin",
    "demo:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
